SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
PORT=8000

# /triage (Week 7 — LLM behind the API)
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY=your real key
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1,    LLM_API_KEY=ollama (literal string, ignored)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key
LLM_MODEL=openrouter/free
LLM_TIMEOUT=30.0
# LLM_STUB=1        -> /triage skips the model entirely, returns a canned valid response
# LLM_ENABLED=false -> kill switch: /triage returns a deterministic fallback, never calls the model
LLM_STUB=0
LLM_ENABLED=true
